data = readtable('liver_cirrhosis.csv');
summary(data) %[output:43fcc51b]
tabulate(data.Stage) %[output:72af24e0]
data.Sex = categorical(data.Sex);
data.Drug = categorical(data.Drug);
data.Status = categorical(data.Status);
data = rmmissing(data); % fill missign data with the mean
X = data(:, 1:end-1);   % everything except Stage
Y = data.Stage;

cv = cvpartition(Y, 'HoldOut', 0.2);% training data

X.N_Days = [];% taking out NDays because in the data if we are checking fibrosis
%after death then the model is cheating
Xtrain = X(training(cv), :);
Ytrain = Y(training(cv));

Xtest = X(test(cv), :);
Ytest = Y(test(cv));

tree = fitctree(Xtrain, Ytrain); %training your decision tree

Ypred = predict(tree, Xtest);

confusionchart(Ytest, Ypred) %[output:9e90e788]
accuracy = mean(Ypred == Ytest) %[output:99ce3f54]



%bar chart with importance of each feature
imp = predictorImportance(tree);

bar(imp) %[output:17bf8881]
xticks(1:length(imp)) %[output:17bf8881]
xticklabels(Xtrain.Properties.VariableNames) %[output:17bf8881]
xtickangle(45) %[output:17bf8881]
ylabel('Feature Importance') %[output:17bf8881]
title('Predictor Importance') %[output:17bf8881]

